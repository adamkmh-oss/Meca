# ---------------------------------------------------------------------------
# STRUCTURA — variables d'environnement (copier en .env.local, ne jamais versionner)
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettez
# jamais de secret. Toutes les autres restent côté serveur.
# ---------------------------------------------------------------------------

# Adresse publique du site (liens des e-mails, cookies Secure en https)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# Supabase (Project Settings > API). Clé publique : anon ou « publishable ».
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service (secret, serveur uniquement) : enregistrement des notes
# corrigées par le serveur, limitation de débit, suspension/suppression de comptes.
SUPABASE_SERVICE_ROLE_KEY=

# Tuteur IA (Claude) — facultatif : sans clé, le tuteur s'affiche « non configuré »
ANTHROPIC_API_KEY=

# E-mails applicatifs (confirmation de suppression de compte) — facultatif
RESEND_API_KEY=
EMAIL_FROM=STRUCTURA <no-reply@votre-domaine.fr>

# Suivi des erreurs (Sentry) — facultatif
SENTRY_DSN=

# Antivirus des documents déposés (démon ClamAV) — facultatif
CLAMAV_HOST=
CLAMAV_PORT=3310

# Limite de tentatives de connexion par adresse IP (10 min), défaut 30.
# À relever seulement pour des tests automatisés locaux.
# AUTH_LOGIN_LIMIT_PER_IP=30

# Mentions légales et RGPD (affichées « à compléter » tant qu'absentes)
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
CONTACT_EMAIL=
LEGAL_DPO_EMAIL=
LEGAL_HOST=Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis
LEGAL_DATA_REGION=Union européenne (Supabase, région eu-west-3 Paris)
